<?xml version="1.0" encoding="utf-8"?>
<!-- The visible setup wizard, shared by both packages: what is being
     installed, (point only) the connection code, confirmation, progress,
     finish with the place of the installation log; for an installed product:
     repair / remove. Stock dialogs come from wixl's "ui" extension.
     Each product sets SD_ABOUT (what it installs) and, for the point,
     SD_ASKCODE=1. A silent install (msiexec /qn) shows none of this. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <UI Id="SD_UI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <Dialog Id="SDWelcomeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no" Text="WixUI_Bmp_Dialog" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Disabled="yes" Text="Back" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="135" Y="20" Width="220" Height="40" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Bigger}[ProductName] [ProductVersion]" />
        <Control Id="About" Type="Text" X="135" Y="62" Width="220" Height="100" Transparent="yes" NoPrefix="yes" Text="[SD_ABOUT]" />
        <Control Id="Note" Type="Text" X="135" Y="166" Width="220" Height="60" Transparent="yes" NoPrefix="yes" Text="The computer is never restarted. Settings are kept in [CommonAppDataFolder]SlipDrukka. Free software under the GNU AGPL v3: github.com/TrueNihilisme/SlipDrukka" />
      </Dialog>

      <Dialog Id="SDCodeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Code" Type="Edit" X="20" Y="110" Width="330" Height="18" Property="CODE" Text="{2000}" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Connection code" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes" Text="The code tells this shop where its server is." />
        <Control Id="Help" Type="Text" X="20" Y="60" Width="330" Height="44" NoPrefix="yes" Text="Paste the code from the server panel (Add shop). It starts with SD1-. You can leave this empty and enter the code later on the shop page: the icon next to the clock, or http://127.0.0.1:7320" />
      </Dialog>

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="SDWelcomeDlg" Control="Next" Event="NewDialog" Value="SDCodeDlg" Condition="SD_ASKCODE" />
      <Publish Dialog="SDWelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="NOT SD_ASKCODE" />
      <Publish Dialog="SDCodeDlg" Control="Back" Event="NewDialog" Value="SDWelcomeDlg" Condition="1" />
      <Publish Dialog="SDCodeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="1" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SDCodeDlg" Condition="NOT Installed AND SD_ASKCODE" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SDWelcomeDlg" Condition="NOT Installed AND NOT SD_ASKCODE" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" Condition="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" Condition="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" Condition="1" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" Condition="1" />
      <!-- Finish: the shop program starts its icon next to the clock (SDStart), or the icon and
           the shop page when the box is ticked (SDOpen); the server opens its panel (SDOpen).
           Each product defines these actions; not after a removal or repair (Installed). -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SDOpen" Order="1" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SDStart" Order="2" Condition="SD_TRAY AND NOT WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" Condition="1" />

      <InstallUISequence>
        <Show Dialog="SDWelcomeDlg" Before="ProgressDlg" Condition="NOT Installed" />
      </InstallUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
